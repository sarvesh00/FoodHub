---
import { site } from '../site.config';
import { languages, langs, href, useT, brandFor, type Lang } from '../lib/i18n';
interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const t = useT(lang);
const nav = [
  { key: 'nav.products', to: 'products/' },
  { key: 'nav.howToCook', to: 'how-to-cook/' },
  { key: 'nav.story', to: 'our-story/' },
  { key: 'nav.faq', to: 'faq/' },
] as const;
const current = (to: string) => path.startsWith(to);
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={href(lang)}>
      <svg viewBox="0 0 32 32" width="34" height="34" aria-hidden="true">
        <circle cx="16" cy="16" r="15" fill="var(--c-tawa)" />
        <circle cx="16" cy="16" r="10.5" fill="var(--c-accent)" />
        <circle cx="12.5" cy="13" r="1.3" fill="var(--c-primary)" />
        <circle cx="19" cy="15" r="1.1" fill="var(--c-primary)" />
        <circle cx="15" cy="19.5" r="1.2" fill="var(--c-primary)" />
      </svg>
      <span>{brandFor(lang)}</span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      {nav.map((n) => <a href={href(lang, n.to)} aria-current={current(n.to) ? 'page' : undefined}>{t(n.key)}</a>)}
    </nav>

    <div class="tools">
      <details class="lang">
        <summary aria-label={t('nav.language')}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z" /></svg>
          <span>{languages[lang].label}</span>
        </summary>
        <ul>
          {langs.map((l) => (
            <li><a href={href(l, path)} hreflang={languages[l].htmlLang} lang={languages[l].htmlLang} aria-current={l === lang ? 'true' : undefined}>{languages[l].label}</a></li>
          ))}
        </ul>
      </details>
      <a class="btn btn--primary order-btn" href={href(lang, 'order/')}>{t(site.orderingEnabled ? 'nav.order' : 'nav.contact')}</a>
      <details class="menu">
        <summary>{t('nav.menu')}</summary>
        <nav aria-label="Mobile">
          {nav.map((n) => <a href={href(lang, n.to)}>{t(n.key)}</a>)}
          <a href={href(lang, 'order/')}>{t('nav.order')}</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--c-paper) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 1rem; min-height: 68px; }
  .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--c-ink); font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; white-space: nowrap; }
  .nav-desktop { display: none; gap: 1.4rem; margin-left: 1.5rem; }
  .nav-desktop a { color: var(--c-ink); text-decoration: none; font-weight: 600; }
  .nav-desktop a:hover, .nav-desktop a[aria-current] { color: var(--c-primary); text-decoration: underline; text-decoration-thickness: 2px; }
  .tools { margin-left: auto; display: flex; align-items: center; gap: 0.5rem; }
  details { position: relative; }
  summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 0.35rem; min-height: 44px; padding: 0 0.7rem; border-radius: 999px; border: 1.5px solid var(--line); font-weight: 600; background: #fff; }
  summary::-webkit-details-marker { display: none; }
  .lang summary span { display: none; }
  .lang ul, .menu nav { position: absolute; right: 0; top: calc(100% + 6px); background: #fff; border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow); padding: 0.4rem; margin: 0; list-style: none; min-width: 11rem; }
  .lang a, .menu a { display: block; padding: 0.6rem 0.8rem; border-radius: 10px; color: var(--c-ink); text-decoration: none; font-weight: 600; }
  .lang a:hover, .menu a:hover { background: var(--paper-2); }
  .lang a[aria-current] { color: var(--c-primary); }
  .order-btn { display: none; min-height: 44px; padding-block: 0.4rem; }
  @media (min-width: 560px) { .lang summary span { display: inline; } .order-btn { display: inline-flex; } }
  @media (min-width: 900px) { .nav-desktop { display: flex; } .menu { display: none; } }
</style>
