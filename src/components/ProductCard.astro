---
import ProductArt from './ProductArt.astro';
import { site } from '../site.config';
import { href, pick, rupees, useT, type Lang } from '../lib/i18n';
import { minPrice, type Product } from '../lib/products';
interface Props { lang: Lang; product: Product }
const { lang, product: p } = Astro.props;
const t = useT(lang);
const name = pick(p.name, lang);
const price = minPrice(p);
const upcoming = p.status === 'upcoming';
const link = href(lang, `products/${p.slug}/`);
---
<article class:list={['pcard', { upcoming }]}>
  {upcoming ? (
    <div class="art-box"><ProductArt class="art" dough={p.art.dough} fleck={p.art.fleck} /></div>
  ) : (
    <a href={link} tabindex="-1" aria-hidden="true"><ProductArt class="art" dough={p.art.dough} fleck={p.art.fleck} /></a>
  )}
  <div class="body">
    {upcoming && <span class="badge">{t('product.upcoming')}</span>}
    {!upcoming && p.featured && <span class="badge badge--flag">{t('product.flagship')}</span>}
    <h3>{upcoming ? name : <a href={link}>{name}</a>}</h3>
    <p class="muted">{pick(p.short, lang)}</p>
    {!upcoming && (
      <div class="foot">
        {site.showPrices && price !== undefined && <span class="price"><small>{t('product.from')}</small> {rupees(price)}</span>}
        <a class="more" href={link}>{t('product.view')} →</a>
      </div>
    )}
  </div>
</article>

<style>
  .pcard { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); display: flex; flex-direction: column; }
  .pcard > a, .art-box { display: block; background: var(--paper-2); padding: 1.4rem; }
  .body .badge { align-self: flex-start; }
  .badge--flag { background: var(--c-primary); color: #fff; }
  .pcard :global(.art) { width: 100%; max-width: 260px; margin-inline: auto; transition: transform 0.4s; }
  .pcard:hover :global(.art) { transform: rotate(-8deg) scale(1.02); }
  .upcoming :global(.art) { filter: grayscale(0.55); opacity: 0.75; max-width: 160px; }
  .body { padding: 1.2rem 1.4rem 1.4rem; display: flex; flex-direction: column; flex: 1; }
  h3 { margin: 0.3rem 0 0.3rem; }
  h3 a { color: var(--c-ink); text-decoration: none; }
  h3 a:hover { color: var(--c-primary); }
  .foot { margin-top: auto; display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-top: 0.6rem; }
  .price { font-weight: 700; font-size: 1.2rem; }
  .price small { font-weight: 400; color: var(--muted); font-size: 0.85rem; }
  .more { font-weight: 700; text-decoration: none; }
</style>
