---
/**
 * su·chef wordmark. The middle dot is a tawa with a pinch of masala.
 * Latin wordmark is the primary mark on every language page.
 */
interface Props { class?: string; tone?: 'dark' | 'light' }
const { class: className = '', tone = 'dark' } = Astro.props;
---
<span class:list={['logo', `logo--${tone}`, className]} role="img" aria-label="SuChef">
  <span class="su" aria-hidden="true">su</span><svg class="dot" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="11" class="tawa" />
    <circle cx="12" cy="12" r="7.6" fill="none" stroke="rgb(255 255 255 / 0.16)" stroke-width="1" />
    <circle cx="9.6" cy="10.4" r="1.9" fill="#E3A21A" />
    <circle cx="13.6" cy="9.4" r="1.3" fill="#E3A21A" />
    <circle cx="12.8" cy="13.6" r="1.6" fill="#E3A21A" />
    <circle cx="9.9" cy="14.2" r="0.9" fill="#E3A21A" />
  </svg><span class="chef" aria-hidden="true">chef</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; font-family: 'Poppins', system-ui, sans-serif; font-weight: 600; letter-spacing: -0.035em; line-height: 1; white-space: nowrap; }
  .su { color: var(--c-primary); }
  .chef { color: var(--c-ink); }
  .dot { width: 0.42em; height: 0.42em; margin: 0 0.07em; transform: translateY(0.08em); flex-shrink: 0; }
  .tawa { fill: #2B2B2B; }
  .logo--light .su { color: var(--c-accent); }
  .logo--light .chef { color: #fff; }
  .logo--light .tawa { fill: #4a4a4a; }
</style>
