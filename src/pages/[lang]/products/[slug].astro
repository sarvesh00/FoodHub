---
import Base from '../../../layouts/Base.astro';
import ProductArt from '../../../components/ProductArt.astro';
import Tbc from '../../../components/Tbc.astro';
import WaProductButton from '../../../components/WaProductButton.astro';
import { site } from '../../../site.config';
import { langs, href, pick, rupees, useT, withBase, type Lang } from '../../../lib/i18n';
import { activeProducts, categoryOf, type Product } from '../../../lib/products';

export function getStaticPaths() {
  return langs.flatMap((lang) => activeProducts.map((product) => ({ params: { lang, slug: product.slug }, props: { product } })));
}
const lang = Astro.params.lang as Lang;
const { product: p } = Astro.props as { product: Product };
const t = useT(lang);
const name = pick(p.name, lang);
const cat = categoryOf(p);
const cooking = p.cooking ? pick(p.cooking, lang) : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: pick(p.name, 'en'),
  description: pick(p.short, 'en'),
  brand: { '@type': 'Brand', name: site.brandName },
  ...(cat ? { category: pick(cat.name, 'en') } : {}),
  ...(site.showPrices && p.priceRupees != null
    ? {
        offers: {
          '@type': 'Offer',
          priceCurrency: 'INR',
          price: p.priceRupees,
          availability: site.orderingEnabled ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
          url: new URL(withBase(`${lang}/products/${p.slug}/`), Astro.site).href,
        },
      }
    : {}),
};
---
<Base lang={lang} path={`products/${p.slug}/`} title={name} description={`${pick(p.short, lang)} ${cat ? pick(cat.name, lang) + ' · ' : ''}Mumbai.`} jsonLd={jsonLd}>
  <section class="section">
    <div class="wrap">
      <p class="small crumbs">
        <a href={href(lang, 'products/')}>{t('product.all')}</a>
        {cat && <> › <a href={href(lang, `collections/${cat.slug}/`)}>{pick(cat.name, lang)}</a></>}
      </p>
      <div class="pgrid">
        <figure class="art-wrap">
          <ProductArt dough={p.art.dough} fleck={p.art.fleck} shape={p.shape} label={name} />
          <figcaption class="small muted">{t('product.illustration')}</figcaption>
        </figure>
        <div>
          {p.featured && <span class="badge flag">{t('product.flagship')}</span>}
          <h1>{name}</h1>
          <p class="lead">{pick(p.short, lang)}</p>
          <dl class="facts">
            {site.showPrices && <div><dt>{t('product.price')}</dt><dd>{p.priceRupees != null ? rupees(p.priceRupees) : <Tbc lang={lang} />}</dd></div>}
            <div><dt>{t('product.netWeight')}</dt><dd>{p.netWeight ?? <Tbc lang={lang} />}</dd></div>
          </dl>
          <div class="cta">
            <WaProductButton lang={lang} product={name} block />
            {!site.orderingEnabled && <p class="small muted">{t('soon.text')}</p>}
          </div>
        </div>
      </div>

      <div class="details">
        <div>
          <h2>{t('product.cooking')}</h2>
          {cooking ? <ol class="steps">{cooking.map((s) => <li>{s}</li>)}</ol> : <p><Tbc lang={lang} /></p>}
        </div>
        <dl class="facts">
          <div><dt>{t('product.ingredients')}</dt><dd>{p.ingredients ? pick(p.ingredients, lang).join(', ') : <Tbc lang={lang} />}</dd></div>
          <div><dt>{t('product.allergens')}</dt><dd>{p.allergens ? pick(p.allergens, lang) : <Tbc lang={lang} />}</dd></div>
          <div><dt>{t('product.shelfLife')}</dt><dd>{p.shelfLife ? pick(p.shelfLife, lang) : <Tbc lang={lang} />}</dd></div>
          {site.fssaiNumber && <div><dt>FSSAI</dt><dd>{site.fssaiNumber}</dd></div>}
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .pgrid { display: grid; gap: 2rem; align-items: center; margin-top: 1rem; }
  @media (min-width: 860px) { .pgrid { grid-template-columns: 1fr 1.1fr; gap: 3.5rem; } }
  .art-wrap { margin: 0; background: var(--green-soft); border-radius: var(--radius-lg); padding: clamp(1.5rem, 5vw, 3rem); text-align: center; }
  .art-wrap :global(svg) { max-width: 400px; margin-inline: auto; filter: drop-shadow(0 18px 30px rgb(30 30 30 / 0.28)); }
  .art-wrap figcaption { margin-top: 1rem; }
  .cta { margin-top: 1.5rem; display: grid; gap: 0.6rem; }
  .details { display: grid; gap: 2.5rem; margin-top: 3.5rem; }
  @media (min-width: 860px) { .details { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .details h2 { font-size: 1.5rem; }
  .flag { background: var(--c-primary); color: #fff; margin-bottom: 0.8rem; }
</style>
