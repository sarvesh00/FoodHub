---
import Base from '../../../layouts/Base.astro';
import ProductArt from '../../../components/ProductArt.astro';
import ComingSoon from '../../../components/ComingSoon.astro';
import WaIcon from '../../../components/WaIcon.astro';
import { site } from '../../../site.config';
import { langs, href, pick, rupees, useT, withBase, type Lang } from '../../../lib/i18n';
import { activeProducts, categoryOf, type Product } from '../../../lib/products';

export function getStaticPaths() {
  return langs.flatMap((lang) => activeProducts.map((product) => ({ params: { lang, slug: product.slug }, props: { product } })));
}
const lang = Astro.params.lang as Lang;
const { product: p } = Astro.props as { product: Product };
const t = useT(lang);
const name = pick(p.name, lang);
const packs = p.packs ?? [];
const cat = categoryOf(p);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: pick(p.name, 'en'),
  description: pick(p.short, 'en'),
  brand: { '@type': 'Brand', name: site.brandName },
  ...(cat ? { category: pick(cat.name, 'en') } : {}),
  ...(site.showPrices && packs.length
    ? {
        offers: packs.map((k) => ({
          '@type': 'Offer',
          priceCurrency: 'INR',
          price: k.priceRupees,
          name: k.size,
          availability: site.orderingEnabled ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
          url: new URL(withBase(`${lang}/products/${p.slug}/`), Astro.site).href,
        })),
      }
    : {}),
};
---
<Base lang={lang} path={`products/${p.slug}/`} title={name} description={pick(p.short, lang)} jsonLd={jsonLd}>
  <section class="section">
    <div class="wrap">
      <p class="small crumbs">
        <a href={href(lang, 'products/')}>{t('product.all')}</a>
        {cat && <> › <a href={href(lang, `collections/${cat.slug}/`)}>{pick(cat.name, lang)}</a></>}
      </p>
      <div class="pgrid">
        <div class="art-wrap">
          <ProductArt dough={p.art.dough} fleck={p.art.fleck} label={name} />
        </div>
        <div>
          {p.featured && <span class="badge flag">{t('product.flagship')}</span>}
          <h1>{name}</h1>
          <p class="lead">{p.description ? pick(p.description, lang) : pick(p.short, lang)}</p>

          {packs.length > 0 && (
            <ul class="packs">
              {packs.map((k) => (
                <li>
                  <strong>{k.size}</strong>
                  {k.makes && <span class="muted small">{pick(k.makes, lang)}</span>}
                  {site.showPrices && <span class="price">{rupees(k.priceRupees)}</span>}
                </li>
              ))}
            </ul>
          )}

          {site.orderingEnabled ? (
            <a class="btn btn--wa btn--block" href={href(lang, `order/?add=${p.slug}`)}><WaIcon /> {t('product.add')}</a>
          ) : (
            <ComingSoon lang={lang} product={name} compact />
          )}
        </div>
      </div>

      <div class="details">
        <div>
          <h2>{t('product.cooking')}</h2>
          {p.cooking && (
            <ol class="steps">
              {pick(p.cooking, lang).map((s) => <li>{s}</li>)}
            </ol>
          )}
        </div>
        <dl class="facts">
          {p.ingredients && <div><dt>{t('product.ingredients')}</dt><dd>{pick(p.ingredients, lang).join(', ')}</dd></div>}
          {p.allergens && <div><dt>{t('product.allergens')}</dt><dd>{pick(p.allergens, lang)}</dd></div>}
          {packs.length > 0 && <div><dt>{t('product.packSize')}</dt><dd>{packs.map((k) => k.size).join(' / ')}</dd></div>}
          {p.shelfLife && <div><dt>{t('product.shelfLife')}</dt><dd>{pick(p.shelfLife, lang)}</dd></div>}
          {p.storage && <div><dt>{t('product.storage')}</dt><dd>{pick(p.storage, lang)}</dd></div>}
          <div><dt>{t('product.fssai')}</dt><dd>{site.fssaiNumber || t('footer.fssaiPending')}</dd></div>
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .pgrid { display: grid; gap: 2rem; align-items: center; margin-top: 1rem; }
  @media (min-width: 860px) { .pgrid { grid-template-columns: 1fr 1.1fr; gap: 3.5rem; } }
  .art-wrap { background: var(--paper-2); border-radius: var(--radius-lg); padding: clamp(1.5rem, 5vw, 3rem); }
  .art-wrap :global(svg) { max-width: 420px; margin-inline: auto; filter: drop-shadow(0 18px 30px rgb(40 25 10 / 0.3)); }
  .packs { list-style: none; padding: 0; margin: 1.5rem 0; display: grid; gap: 0.6rem; }
  .packs li { display: flex; align-items: baseline; gap: 0.8rem; flex-wrap: wrap; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 0.8rem 1rem; }
  .packs .price { margin-left: auto; font-weight: 700; font-size: 1.15rem; }
  .details { display: grid; gap: 2.5rem; margin-top: 3.5rem; }
  @media (min-width: 860px) { .details { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .details h2 { font-size: 1.5rem; }
  .flag { background: var(--c-primary); color: #fff; margin-bottom: 0.8rem; }
</style>
