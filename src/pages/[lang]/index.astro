---
import Base from '../../layouts/Base.astro';
import ProductArt from '../../components/ProductArt.astro';
import ProductCard from '../../components/ProductCard.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import WaIcon from '../../components/WaIcon.astro';
import { site } from '../../site.config';
import { langs, href, useT, type Lang } from '../../lib/i18n';
import { activeProducts, upcomingProducts } from '../../lib/products';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const [hero1, hero2] = activeProducts;
const steps = [1, 2, 3] as const;
const whys = [1, 2, 3] as const;
---
<Base lang={lang}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        {!site.orderingEnabled && <span class="badge badge--dot">{t('soon.badge')}</span>}
        <h1>{t('home.heroTitle')}</h1>
        <p class="lead">{t('home.heroText')}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={href(lang, 'products/')}>{t('home.ctaProducts')}</a>
          {site.orderingEnabled ? (
            <a class="btn btn--wa" href={href(lang, 'order/')}><WaIcon /> {t('home.ctaOrder')}</a>
          ) : (
            <a class="btn btn--ghost" href={href(lang, 'order/')}><WaIcon /> {t('notify.button')}</a>
          )}
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        {hero1 && <ProductArt class="a1" dough={hero1.art.dough} fleck={hero1.art.fleck} />}
        {hero2 && <ProductArt class="a2" dough={hero2.art.dough} fleck={hero2.art.fleck} />}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <p class="eyebrow">{t('home.howEyebrow')}</p>
      <h2>{t('home.howTitle')}</h2>
      <ol class="grid grid--3 how">
        {steps.map((n) => (
          <li class="card">
            <span class="num">{n}</span>
            <h3>{t(`home.step${n}Title`)}</h3>
            <p class="muted">{t(`home.step${n}Text`)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{t('home.productsEyebrow')}</p>
      <h2>{t('home.productsTitle')}</h2>
      <div class="grid grid--2 products">
        {activeProducts.map((p) => <ProductCard lang={lang} product={p} />)}
      </div>
      {upcomingProducts.length > 0 && (
        <div class="grid grid--3 upcoming">
          {upcomingProducts.map((p) => <ProductCard lang={lang} product={p} />)}
        </div>
      )}
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <p class="eyebrow">{t('home.whyEyebrow')}</p>
      <div class="grid grid--3">
        {whys.map((n) => (
          <div>
            <h3>{t(`home.why${n}Title`)}</h3>
            <p class="lead">{t(`home.why${n}Text`)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap area-grid">
      <div>
        <p class="eyebrow">{t('home.areaEyebrow')}</p>
        <h2>{t('home.areaTitle')}</h2>
        <p class="muted">{t('home.areaText')}</p>
        <ul class="chips">
          {Object.entries(site.delivery.pincodes).map(([pin, name]) => <li>{name} <span>{pin}</span></li>)}
        </ul>
      </div>
      {!site.orderingEnabled && <ComingSoon lang={lang} />}
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(2.5rem, 7vw, 5rem); overflow: hidden; }
  .hero-grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 860px) { .hero-grid { grid-template-columns: 1.1fr 1fr; } }
  .hero h1 { margin-top: 1rem; }
  .hero .lead { margin-bottom: 1.6rem; }
  .hero-art { position: relative; aspect-ratio: 1.15; max-width: 520px; margin-inline: auto; width: 100%; }
  .hero-art :global(.a1) { position: absolute; width: 74%; left: 0; top: 0; filter: drop-shadow(0 18px 30px rgb(40 25 10 / 0.35)); animation: spin 60s linear infinite; }
  .hero-art :global(.a2) { position: absolute; width: 50%; right: 0; bottom: 0; filter: drop-shadow(0 14px 24px rgb(40 25 10 / 0.35)); animation: spin 80s linear infinite reverse; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .hero-art :global(svg) { animation: none !important; } }
  .how { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  .how .num { display: inline-grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--c-primary); color: #fff; font-weight: 700; margin-bottom: 0.8rem; }
  .products { margin-top: 1.5rem; }
  .upcoming { margin-top: 1.25rem; }
  .area-grid { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 860px) { .area-grid { grid-template-columns: 1fr 1fr; } }
  .chips { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips li { background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 0.35rem 0.9rem; font-weight: 600; }
  .chips span { color: var(--muted); font-weight: 400; font-size: 0.9rem; margin-left: 0.3rem; }
</style>
