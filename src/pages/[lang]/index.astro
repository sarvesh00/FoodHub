---
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import ProductArt from '../../components/ProductArt.astro';
import ProductCard from '../../components/ProductCard.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import WhySuChef from '../../components/WhySuChef.astro';
import CleanLabelBadge from '../../components/CleanLabelBadge.astro';
import WaIcon from '../../components/WaIcon.astro';
import { site } from '../../site.config';
import { langs, href, pick, useT, waLink, type Lang } from '../../lib/i18n';
import { categories, featuredProducts, productsIn, upcomingProducts } from '../../lib/products';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const sub = pick(site.taglineSub, lang);
// Hero art: one product from each of the first two categories.
const heroArt = categories.map((c) => productsIn(c, featuredProducts)[0]).filter(Boolean).slice(0, 3);
const groups = categories.map((c) => ({ c, items: productsIn(c, featuredProducts) })).filter((g) => g.items.length > 0);
const steps = [1, 2, 3] as const;
const values = [1, 2, 3, 4] as const;
---
<Base lang={lang}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        {!site.orderingEnabled && <span class="badge badge--dot">{t('soon.badge')}</span>}
        <p class="hero-logo"><Logo /></p>
        <h1 lang="en">{site.tagline}</h1>
        {sub && <p class="tag-sub">{sub}</p>}
        <p class="lead">{t('hero.line')}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={href(lang, 'products/')}>{t('hero.ctaProducts')}</a>
          <a class="btn btn--ghost" href={href(lang, 'order/')}><WaIcon /> {t(site.orderingEnabled ? 'product.orderWa' : 'notify.button')}</a>
        </div>
        <CleanLabelBadge />
      </div>
      <div class="hero-art" aria-hidden="true">
        {heroArt.map((p, i) => p && <ProductArt class={`a${i + 1}`} dough={p.art.dough} fleck={p.art.fleck} shape={p.shape} />)}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <p class="eyebrow">{t('how.eyebrow')}</p>
      <h2>{t('how.title')}</h2>
      <ol class="grid grid--3 how">
        {steps.map((n) => (
          <li class="card">
            <span class="num">{n}</span>
            <h3>{t(`how.step${n}Title`)}</h3>
            <p class="muted">{t(`how.step${n}Text`)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{t('range.eyebrow')}</p>
      <h2 class="subhead-h">{t('range.subhead')}</h2>
      {groups.map(({ c, items }) => (
        <div class="range">
          <div class="range-head">
            <div>
              <h3 class="cat-title">{pick(c.name, lang)}</h3>
              <p class="muted">{pick(c.short, lang)}</p>
            </div>
            <a class="more" href={href(lang, `collections/${c.slug}/`)}>{t('range.seeAll', { category: pick(c.name, lang) })} →</a>
          </div>
          <div class="grid grid--2 products">
            {items.map((p) => <ProductCard lang={lang} product={p} />)}
          </div>
        </div>
      ))}
      {upcomingProducts.length > 0 && (
        <div class="grid grid--3 upcoming">
          {upcomingProducts.map((p) => <ProductCard lang={lang} product={p} />)}
        </div>
      )}
    </div>
  </section>

  <section class="section section--green">
    <div class="wrap"><WhySuChef lang={lang} /></div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <p class="eyebrow">{t('value.eyebrow')}</p>
      <div class="grid grid--4">
        {values.map((n) => (
          <div>
            <h3>{t(`value.${n}Title`)}</h3>
            <p class="lead">{t(`value.${n}Text`)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="nri">
    <div class="wrap nri">
      <div>
        <p class="eyebrow">{t('nri.eyebrow')}</p>
        <h2>{t('nri.title')}</h2>
        <p class="lead">{t('nri.text')}</p>
      </div>
      <div class="card nri-card">
        <span class="badge badge--dot">{t('nri.badge')}</span>
        <a class="btn btn--wa" href={waLink(t('notify.messageNri'))} target="_blank" rel="noopener"><WaIcon /> {t('nri.cta')}</a>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap area-grid">
      <div>
        <p class="eyebrow">{t('area.eyebrow')}</p>
        <h2>{t('area.title')}</h2>
        <p class="muted">{t('area.text')}</p>
        <ul class="chips">
          {Object.entries(site.delivery.pincodes).map(([pin, name]) => <li>{name} <span>{pin}</span></li>)}
        </ul>
      </div>
      {!site.orderingEnabled && <ComingSoon lang={lang} />}
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(2.5rem, 7vw, 5rem); overflow: hidden; }
  .hero-grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 860px) { .hero-grid { grid-template-columns: 1.1fr 1fr; } }
  .hero-logo { font-size: clamp(2.6rem, 8vw, 4rem); margin: 1.2rem 0 0.6rem; }
  .hero h1 { font-size: clamp(2.1rem, 6vw, 3.6rem); margin-bottom: 0.2rem; letter-spacing: -0.03em; }
  .tag-sub { font-size: 1.25rem; font-weight: 500; color: var(--c-primary); margin-bottom: 0.8rem; }
  .hero .lead { margin: 0.8rem 0 1.6rem; font-size: 1.25rem; }
  .hero-art { position: relative; aspect-ratio: 1.15; max-width: 520px; margin-inline: auto; width: 100%; }
  .hero-art :global(svg) { position: absolute; filter: drop-shadow(0 16px 28px rgb(30 30 30 / 0.32)); }
  .hero-art :global(.a1) { width: 64%; left: 0; top: 0; animation: spin 70s linear infinite; }
  .hero-art :global(.a2) { width: 44%; right: 0; top: 10%; animation: spin 90s linear infinite reverse; }
  .hero-art :global(.a3) { width: 46%; right: 14%; bottom: 0; animation: spin 80s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .hero-art :global(svg) { animation: none !important; } }
  .how { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  .how .num { display: inline-grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--c-primary); color: #fff; font-weight: 600; margin-bottom: 0.8rem; }
  .subhead-h { color: var(--c-primary); }
  .range { margin-top: 2.2rem; }
  .range + .range { margin-top: 3rem; }
  .range-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 0.5rem 2rem; }
  .cat-title { font-size: 1.5rem; margin-bottom: 0.2rem; }
  .range-head p { max-width: 40rem; margin: 0; }
  .more { font-weight: 600; text-decoration: none; white-space: nowrap; }
  .products { margin-top: 1.2rem; }
  .upcoming { margin-top: 1.25rem; }
  .nri { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 860px) { .nri { grid-template-columns: 1.4fr 1fr; gap: 3rem; } }
  .nri-card { display: grid; gap: 1rem; justify-items: start; }
  .area-grid { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 860px) { .area-grid { grid-template-columns: 1fr 1fr; } }
  .chips { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips li { background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 0.35rem 0.9rem; font-weight: 500; }
  .chips span { color: var(--muted); font-weight: 400; font-size: 0.9rem; margin-left: 0.3rem; }
</style>
